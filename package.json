{
  "name": "school-result-system",
  "version": "2.0.0",
  "description": "School Result Publication System",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "set-admin": "node scripts/set-admin.js",
    "find-duplicates": "node scripts/find-duplicates.js",
    "restore": "node scripts/restore.js",
    "build:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --watch"
  },
  "keywords": [
    "school",
    "result",
    "management"
  ],
  "author": "MD Fahim",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "jsdom": "^30.1.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
