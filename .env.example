# Copy this file to ".env" for local work. NEVER commit the real .env file.

# PostgreSQL connection (Render: copy the "External Database URL" for local work)
DATABASE_URL=
# DATABASE_SSL=false            # only needed for a local database without SSL

# REQUIRED in production. Long random text. Do not change it later, or printed QR codes stop verifying.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Your public web address (used inside the QR codes), e.g. https://your-school.onrender.com
PUBLIC_BASE_URL=

# Only used when there is NO admin account yet (then remove ADMIN_PASSWORD)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Optional school details for marksheets
# SCHOOL_NAME=Shaheed Nur Hossain Memorial School
# SCHOOL_ADDRESS=Biral, Dinajpur
# SCHOOL_EIIN=

# "gpa"  = pass students ranked by GPA then total marks, failed students get no position (default)
# "marks" = old rule: only total marks
# MERIT_MODE=gpa
